# ============================================================
#  TEMPLATE — salin jadi ".env" (TIDAK di-commit)
#
#     Copy-Item .env.example .env
#
#  Dipakai oleh `node server.js` maupun container backend.
#  Nilai di bawah ini contoh untuk LOCAL DEV (port 5003).
# ============================================================

# ---------- Server ----------
PORT=5003
NODE_ENV=development

# ---------- Keycloak ----------
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=local-pengujian
# Keycloak -> Clients -> <client> -> Credentials
KEYCLOAK_CLIENT_SECRET=ISI_CLIENT_SECRET_KEYCLOAK

# Admin Keycloak (dipakai routes/keycloak.js -> Admin REST API)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ISI_PASSWORD_ADMIN_KEYCLOAK

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:3004

# ---------- Database MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pengujian

# ---------- Security ----------
# Buat nilai acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=ISI_RANDOM_32_BYTE_BASE64
SESSION_SECRET=ISI_RANDOM_32_BYTE_BASE64

# ---------- Opsional ----------
# SENSOR_ROOMS=server,ruang_rapat
# DATA_PATH=./data
# UPLOADS_PATH=./uploads
