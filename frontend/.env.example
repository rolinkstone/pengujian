# ============================================================
#  TEMPLATE — salin jadi ".env" (TIDAK di-commit)
#
#     Copy-Item .env.example .env
#
#  ⚠️ Nilai NEXT_PUBLIC_* di-"bake" saat `next build`.
#     Kalau berubah, container frontend HARUS di-build ulang:
#       docker compose build --no-cache frontend
# ============================================================

# ---------- Backend API ----------
NEXT_PUBLIC_API_URL=http://localhost:5003/api

# ---------- Keycloak (sisi server / NextAuth) ----------
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=local-pengujian
KEYCLOAK_CLIENT_SECRET=ISI_CLIENT_SECRET_KEYCLOAK

# ---------- Keycloak (sisi browser, untuk logout SSO) ----------
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=local-pengujian

# ---------- NextAuth ----------
# Harus SAMA dengan alamat frontend saat dibuka di browser.
NEXTAUTH_URL=http://localhost:3004
NEXTAUTH_SECRET=ISI_RANDOM_32_BYTE_BASE64
