# ============================================================
#  JANGAN PERNAH commit file berisi kredensial.
#  Salin template berikut lalu isi nilainya:
#     .env.example          -> .env            (dipakai docker compose)
#     backend/.env.example  -> backend/.env
#     frontend/.env.example -> frontend/.env
#     arduino/secrets.example.h -> arduino/secrets.h
# ============================================================

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example
!*.env.example

# Kredensial perangkat (Wi-Fi, password hotspot, dll.)
arduino/secrets.h
secrets.h

# Kunci & sertifikat
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.js
.yarn/

# ---------- Build output ----------
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# ---------- Runtime data (jangan ikut ter-push) ----------
data/backend/*
!data/backend/.gitkeep
data/frontend/*
!data/frontend/.gitkeep

# Artefak lama untuk hosting lain (memuat kredensial DB + bridge key).
# Fitur sinkronisasi bridge sudah dihapus dari backend, jadi file ini
# hanya disimpan lokal dan TIDAK ikut ke GitHub.
data/bridge/

backend/uploads/*
!backend/uploads/.gitkeep
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pm2/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
