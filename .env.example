# ============================================================
#  TEMPLATE — salin jadi ".env" lalu isi nilainya.
#  File ".env" TIDAK di-commit (lihat .gitignore).
#
#     Copy-Item .env.example .env
#
#  File ".env" dibaca otomatis oleh `docker compose` di folder ini.
# ============================================================

# ---------- URL publik ----------
# WEB_URL = alamat web  (juga dipakai sebagai NEXTAUTH_URL)
# API_URL = alamat API  (dipakai browser -> NEXT_PUBLIC_API_URL)
WEB_URL=https://lets-digital.bbpompky.id
API_URL=https://data-lets.bbpompky.id/api

# ---------- Database MySQL ----------
# MySQL DI LUAR Docker (bukan container).
# Backend memakai network_mode: "host", jadi 127.0.0.1 di dalam container
# = server itu sendiri. MySQL TIDAK perlu dibuka ke jaringan.
#   MySQL di server yang sama, di luar Docker -> 127.0.0.1  <== paling umum
#   MySQL di komputer lain di LAN             -> IP komputer itu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pengujian
DB_PASSWORD=ISI_PASSWORD_MYSQL
DB_NAME=pengujian

# ---------- Keycloak ----------
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=pengujian
# Keycloak -> Clients -> pengujian -> Credentials
KEYCLOAK_CLIENT_SECRET=ISI_CLIENT_SECRET_KEYCLOAK

# Admin Keycloak (dipakai backend membaca daftar user via Admin REST API)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ISI_PASSWORD_ADMIN_KEYCLOAK

# ---------- NextAuth ----------
# NEXTAUTH_URL otomatis memakai WEB_URL (lihat docker-compose.yml).
# Buat nilai acak untuk secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=ISI_RANDOM_32_BYTE_BASE64

# ---------- Opsional ----------
# Paksa daftar ruangan sensor selalu tampil, mis. "server,ruang_rapat"
# SENSOR_ROOMS=
